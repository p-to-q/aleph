{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aleph-Bench Kaggle Replay Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptVersion",
    "sourceProtocolVersion",
    "sourceRunSha256",
    "state",
    "startedAt",
    "endedAt",
    "pyRunId",
    "taskIdentity",
    "modelIdentity",
    "datasetIdentity",
    "scoringIdentity",
    "operatorAssertions",
    "expectedRowCount",
    "rowCount",
    "leaderboardScalar",
    "replayedScalar",
    "scalarMatches",
    "diagnostics",
    "submissionRows",
    "benchResult",
    "notes",
    "id"
  ],
  "properties": {
    "receiptVersion": {
      "const": "0.2.0"
    },
    "sourceProtocolVersion": {
      "const": "0.1-legacy"
    },
    "sourceRunSha256": {
      "$ref": "#/$defs/sha256"
    },
    "state": {
      "const": "BENCHMARK_TASK_RUN_STATE_COMPLETED"
    },
    "startedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "endedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "pyRunId": {
      "type": "string",
      "minLength": 1
    },
    "taskIdentity": {
      "$ref": "#/$defs/taskIdentity"
    },
    "modelIdentity": {
      "$ref": "#/$defs/modelIdentity"
    },
    "datasetIdentity": {
      "$ref": "#/$defs/datasetIdentity"
    },
    "scoringIdentity": {
      "$ref": "#/$defs/scoringIdentity"
    },
    "operatorAssertions": {
      "$ref": "#/$defs/operatorAssertions"
    },
    "expectedRowCount": {
      "const": 180
    },
    "rowCount": {
      "const": 180
    },
    "leaderboardScalar": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "replayedScalar": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "scalarMatches": {
      "const": true
    },
    "diagnostics": {
      "$ref": "#/$defs/diagnostics"
    },
    "submissionRows": {
      "type": "array",
      "minItems": 180,
      "maxItems": 180,
      "items": {
        "$ref": "#/$defs/submissionRow"
      }
    },
    "benchResult": {
      "$ref": "#/$defs/benchResult"
    },
    "notes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "id": {
      "type": "string",
      "pattern": "^aleph-bench-kaggle-receipt-v0\\.2-artifact-[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "taskIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "versionNumber",
        "description",
        "definitionSha256"
      ],
      "properties": {
        "name": {
          "const": "aleph_bench_frozen_ladder"
        },
        "versionNumber": {
          "const": 3
        },
        "description": {
          "const": "Score target recovery from non-leaking frozen-ladder prompts using inverse AURC."
        },
        "definitionSha256": {
          "const": "93020f8ac90bd37e3711b6ad233443fc5e7f1ec4f047a8930f1bbf31039f6e02"
        }
      }
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        }
      }
    },
    "datasetIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "packageManifestSha256",
        "referencePackageTreeSha256",
        "items",
        "prompts",
        "itemCount",
        "sendablePromptCount",
        "canaryGuid"
      ],
      "properties": {
        "packageId": {
          "const": "aleph-bench-m0-mock-platform-package"
        },
        "packageManifestSha256": {
          "const": "1f4d0ef9420079f1a5734879c6be716bd7227b950d03703341d4bc74517be8d7"
        },
        "referencePackageTreeSha256": {
          "const": "0ae1f94ff0c599bda3ce69de7027c44d128ddd1653e23f1a05d3e885d469dec4"
        },
        "items": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "prompts": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "itemCount": {
          "const": 30
        },
        "sendablePromptCount": {
          "const": 180
        },
        "canaryGuid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scoringIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scoreOutputs",
        "scoringCore",
        "config",
        "configSha256"
      ],
      "properties": {
        "scoreOutputs": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "scoringCore": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "config": {
          "$ref": "#/$defs/scoringConfig"
        },
        "configSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "scoringConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tau",
        "k",
        "seed",
        "bootstrapSamples",
        "reruns",
        "leakageThresholds"
      ],
      "properties": {
        "tau": {
          "const": 0.9
        },
        "k": {
          "const": 16
        },
        "seed": {
          "const": 0
        },
        "bootstrapSamples": {
          "const": 500
        },
        "reruns": {
          "const": 1
        },
        "leakageThresholds": {
          "const": {
            "lcsRatio": 0.65,
            "trigramOverlap": 0.5,
            "verbatimSpanTokens": 16
          }
        }
      }
    },
    "operatorAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTokens",
        "saturationMarginTokens",
        "maxTokensSource"
      ],
      "properties": {
        "maxTokens": {
          "const": 512
        },
        "saturationMarginTokens": {
          "const": 4
        },
        "maxTokensSource": {
          "const": "operator_asserted_not_present_in_run_json"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "emptyRowIds",
        "invalidUsageRowIds",
        "nearCapRowIds",
        "outputTokenStats"
      ],
      "properties": {
        "status": {
          "enum": [
            "valid",
            "blocked"
          ]
        },
        "emptyRowIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "invalidUsageRowIds": {
          "type": "array",
          "maxItems": 180,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nearCapRowIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputTokenStats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "min",
            "max",
            "mean",
            "nearCapCount",
            "nearCapThreshold"
          ],
          "properties": {
            "count": {
              "const": 180
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            },
            "mean": {
              "type": "number",
              "minimum": 0
            },
            "nearCapCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 180
            },
            "nearCapThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "inputTokensCostNanodollars",
        "outputTokensCostNanodollars",
        "totalBackendLatencyMs"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "inputTokensCostNanodollars": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "outputTokensCostNanodollars": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "totalBackendLatencyMs": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "submissionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rowId",
        "itemId",
        "promptId",
        "rerunIndex",
        "conversationId",
        "requestId",
        "promptText",
        "outputText",
        "usage"
      ],
      "properties": {
        "rowId": {
          "type": "string",
          "minLength": 1
        },
        "itemId": {
          "type": "string",
          "minLength": 1
        },
        "promptId": {
          "type": "string",
          "minLength": 1
        },
        "rerunIndex": {
          "const": 0
        },
        "conversationId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "promptText": {
          "type": "string",
          "minLength": 1
        },
        "outputText": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        }
      }
    },
    "confidenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "high"
      ],
      "properties": {
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        }
      }
    },
    "nullableNumber": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableConfidenceInterval": {
      "anyOf": [
        {
          "$ref": "#/$defs/confidenceInterval"
        },
        {
          "type": "null"
        }
      ]
    },
    "frontierPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tokens",
        "fidelity",
        "distortion",
        "disqualified",
        "rung",
        "paraphrase",
        "frontierRank"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "fidelity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "distortion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "disqualified": {
          "type": "boolean"
        },
        "rung": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "paraphrase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "frontierRank": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "itemMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aurc",
        "eclAtTau",
        "elicitAtK",
        "leakageHitRate"
      ],
      "properties": {
        "aurc": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eclAtTau": {
          "$ref": "#/$defs/nullableNumber"
        },
        "elicitAtK": {
          "type": "boolean"
        },
        "leakageHitRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "itemRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "model",
        "frontier",
        "metrics"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "frontier": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontierPoint"
          }
        },
        "metrics": {
          "$ref": "#/$defs/itemMetrics"
        }
      }
    },
    "modelSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "evidenceMode",
        "itemCount",
        "aurc",
        "aurcCi95",
        "eclAtTau",
        "eclAtTauCi95",
        "coverageAtTau",
        "elicitAtK",
        "elicitAtKCi95",
        "leakageHitRate"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "evidenceMode": {
          "const": "black_box"
        },
        "itemCount": {
          "const": 30
        },
        "aurc": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "aurcCi95": {
          "$ref": "#/$defs/confidenceInterval"
        },
        "eclAtTau": {
          "$ref": "#/$defs/nullableNumber"
        },
        "eclAtTauCi95": {
          "$ref": "#/$defs/nullableConfidenceInterval"
        },
        "coverageAtTau": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "elicitAtK": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "elicitAtKCi95": {
          "$ref": "#/$defs/confidenceInterval"
        },
        "leakageHitRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "benchConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetPath",
        "decoding",
        "evidenceModes",
        "leakageThresholds",
        "bootstrapSamples",
        "reruns"
      ],
      "properties": {
        "datasetPath": {
          "const": "data/public_s2_items.jsonl"
        },
        "decoding": {
          "const": "user-supplied; this scorer consumes pre-generated outputs"
        },
        "evidenceModes": {
          "const": [
            "black_box"
          ]
        },
        "leakageThresholds": {
          "const": {
            "lcsRatio": 0.65,
            "trigramOverlap": 0.5,
            "verbatimSpanTokens": 16
          }
        },
        "bootstrapSamples": {
          "const": 500
        },
        "reruns": {
          "const": 1
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aurc",
        "aurcCi95",
        "eclAtTau",
        "elicitAtK"
      ],
      "properties": {
        "aurc": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "aurcCi95": {
          "$ref": "#/$defs/confidenceInterval"
        },
        "eclAtTau": {
          "$ref": "#/$defs/nullableNumber"
        },
        "elicitAtK": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "benchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "track",
        "split",
        "seed",
        "stratum",
        "metricClasses",
        "tau",
        "k",
        "canaryGuid",
        "config",
        "models",
        "aggregate",
        "itemRuns",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "track": {
          "const": "F"
        },
        "split": {
          "const": "public"
        },
        "seed": {
          "const": 0
        },
        "stratum": {
          "const": "S2"
        },
        "metricClasses": {
          "const": [
            "exact"
          ]
        },
        "tau": {
          "const": 0.9
        },
        "k": {
          "const": 16
        },
        "canaryGuid": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "$ref": "#/$defs/benchConfig"
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/modelSummary"
          }
        },
        "aggregate": {
          "$ref": "#/$defs/aggregate"
        },
        "itemRuns": {
          "type": "array",
          "minItems": 30,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/itemRun"
          }
        },
        "notes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
