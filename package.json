{
  "name": "aleph",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "web",
    "packages/core",
    "packages/ui",
    "packages/fixtures"
  ],
  "scripts": {
    "lint": "node scripts/doctor.mjs && node scripts/check-links.mjs && node scripts/check-placeholders.mjs && node scripts/check-maintenance-routes.mjs && node scripts/check-language.mjs && node scripts/check-core.mjs && node scripts/check-contract.mjs && node scripts/check-fixtures.mjs && node scripts/check-repo.mjs",
    "api:smoke": "PYTHONPATH=apps/api apps/api/.venv/bin/python apps/api/smoke.py",
    "api:live-smoke": "PYTHONPATH=apps/api apps/api/.venv/bin/python apps/api/live_smoke.py",
    "bench:audit": "python3 bench/run.py audit",
    "bench:bundle": "python3 bench/run.py bundle --check bench/results/m0-bundle.json",
    "bench:doctor": "python3 bench/run.py doctor",
    "bench:manifest": "python3 bench/run.py manifest",
    "bench:package": "python3 bench/run.py package --check bench/results/platform/m0-mock/package-manifest.json",
    "bench:report": "python3 bench/run.py report",
    "bench:test": "python3 -m unittest discover bench/tests",
    "bench:verify": "python3 bench/run.py verify --audit bench/results/m0-audit.json --bundle bench/results/m0-bundle.json",
    "bench:run": "python3 bench/run.py run",
    "demo:check": "node scripts/demo-check.mjs",
    "search:preflight": "${ALEPH_PY:-python3} search/preflight.py",
    "dev": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "test": "node scripts/check-core.mjs && node scripts/check-contract.mjs && node scripts/check-fixtures.mjs && node scripts/check-repo.mjs && npm run bench:test"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
